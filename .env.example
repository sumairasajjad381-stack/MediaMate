# ==============================================================================
# ENVIRONMENT CONFIGURATION - INSTAGRAM MEDIA ARCHIVER & DOWNLOADER
# ==============================================================================
# Copy this file to .env and adjust variables as needed.
# NEVER commit .env to version control.

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (Generate with: openssl rand -base64 32)
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
SESSION_SECRET=session-encryption-secret-change-in-production

# Database (Prisma)
# Default is SQLite for zero-configuration local dev.
# For production scale (PostgreSQL): postgresql://user:password@localhost:5432/instadb?schema=public
DATABASE_URL="file:./dev.db"

# Storage Driver: "local" (default) or "s3"
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH="./storage/media"

# S3 / Cloudflare R2 / MinIO Object Storage (Used only when STORAGE_DRIVER=s3)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET_NAME=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL_PREFIX=""

# Instagram Session Cookies (Optional)
# Public posts & reels work WITHOUT session cookies.
# Set these if downloading private posts or bypassing severe rate limits.
INSTAGRAM_SESSION_ID=""
INSTAGRAM_CSRF_TOKEN=""
INSTAGRAM_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/123.0.0.0 Safari/537.36"

# Rate Limiting (Tokens per minute per IP)
RATE_LIMIT_ANONYMOUS=30
RATE_LIMIT_AUTHENTICATED=120
